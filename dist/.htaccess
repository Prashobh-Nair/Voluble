RewriteEngine On

# Handle /professional and /professionals
RewriteRule ^professional/?$ professionals.html [L]
RewriteRule ^professionals/?$ professionals.html [L]

# Handle /carriergrowth, /careergrowth, and /career-growth
RewriteRule ^carriergrowth/?$ career-growth.html [L]
RewriteRule ^careergrowth/?$ career-growth.html [L]
RewriteRule ^career-growth/?$ career-growth.html [L]

# Handle /students
RewriteRule ^students/?$ students.html [L]

# Handle /interview clean URL
RewriteCond %{THE_REQUEST} \s/interview\.html[\s?] [NC]
RewriteRule ^interview\.html$ /interview [R=301,L]
RewriteRule ^interview/?$ interview/index.html [L]

# General .html extension removal
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]
